    "timelineOrigin": {
      "type": "object",
      "properties": {
        "sample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timecode": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}:\\d{2}$"
        }
      },
      "required": [
        "sample",
        "timecode"
      ],
      "additionalProperties": false
    },
