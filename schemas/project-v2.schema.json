{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "suite": {
      "type": "string",
      "const": "Orama"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "storyProjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sampleRate": {
      "type": "number",
      "const": 48000
    },
    "frameRate": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "denominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1001
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "durationSamples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8640000
